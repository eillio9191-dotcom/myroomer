# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TURN Server Configuration (Optional - for relay support when P2P fails)
VITE_TURN_URL=""
VITE_TURN_USERNAME=""
VITE_TURN_PASSWORD=""

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRATION="24h"

# Server Configuration
NODE_ENV="development"
PORT="3002"
FRONTEND_URL="http://localhost:3000"
ADMIN_SECRET="your-admin-secret"

# Database Configuration (for PostgreSQL)
POSTGRES_DB="myroomer"
POSTGRES_USER="myroomer"
POSTGRES_PASSWORD="myroomer_password"
DATABASE_URL="postgresql://myroomer:myroomer_password@localhost:5432/myroomer"

# Redis Configuration (for caching and sessions)
REDIS_URL="redis://localhost:6379"

# MinIO Configuration (for file storage)
MINIO_ROOT_USER="minioadmin"
MINIO_ROOT_PASSWORD="minioadmin123"
MINIO_ENDPOINT="localhost:9000"
MINIO_BUCKET="myroomer-files"

# Grafana Configuration
GRAFANA_USER="admin"
GRAFANA_PASSWORD="admin"

# File Upload Configuration
MAX_FILE_SIZE="52428800"  # 50MB in bytes
UPLOAD_DIR="uploads"

# Logging Configuration
LOG_LEVEL="info"
LOG_DIR="logs"

# Monitoring Configuration
METRICS_ENABLED="true"
HEALTH_CHECK_INTERVAL="30"

# Email Configuration (for notifications)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@myroomer.com"

# Security Configuration
CORS_ORIGIN="http://localhost:3000"
RATE_LIMIT_WINDOW="900000"  # 15 minutes in milliseconds
RATE_LIMIT_MAX="100"

# Cloud Storage Configuration (optional)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION=""
AWS_S3_BUCKET=""

# Google Cloud Configuration (optional)
GOOGLE_CLOUD_PROJECT_ID=""
GOOGLE_CLOUD_KEY_FILE=""
GOOGLE_CLOUD_BUCKET=""

# Azure Configuration (optional)
AZURE_STORAGE_ACCOUNT=""
AZURE_STORAGE_KEY=""
AZURE_CONTAINER=""
